--- a/runtime/shim_pthread.cpp
+++ b/runtime/shim_pthread.cpp
@@ -50,6 +50,19 @@ namespace {
 std::mutex g_registry;
 uint32_t g_next_id = 1;

+// Bionic's static initializers are not all zero. A mutex word holding only
+// type bits (PTHREAD_RECURSIVE_MUTEX_INITIALIZER_NP is 0x4000, the
+// error-checking one 0x8000) has never been created either. ACIES builds every
+// recursive CSLock that way, so treating 0x4000 as an id left the engine's
+// task locks unlocked and let two threads release the same object.
+bool Unclaimed(uint32_t value) { return (value & ~UINT32_C(0xC000)) == 0; }
+
+uint32_t NextId() {
+  uint32_t id;
+  do id = g_next_id++; while (Unclaimed(id));
+  return id;
+}
